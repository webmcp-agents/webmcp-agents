# Datadog agentless OTLP intake (datadoghq.com; EU: otlp.datadoghq.eu)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.datadoghq.com/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS=dd-api-key=<DD_API_KEY>,compute_stats=true
OTEL_SERVICE_NAME=field-store
# Turns the traces into LLM Observability traces too.
OTEL_RESOURCE_ATTRIBUTES=dd_llmobs_enabled=true
