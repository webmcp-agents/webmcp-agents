{
  "name": "@webmcp-agents/chat",
  "version": "0.3.0",
  "type": "module",
  "description": "A chat widget whose agent operates the live page through its WebMCP tools: defineWebAgent (instructions, tool subsets, sub-agents), a cloud adapter for any frontier model, a server handler on the AI SDK and a Vite dev plugin.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@webmcp-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "@webmcp-agents/source": "./src/agent.ts",
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./server": {
      "@webmcp-agents/source": "./src/server/index.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "@webmcp-agents/source": "./src/vite/index.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./chat.css": {
      "@webmcp-agents/source": "./src/chat.css",
      "default": "./dist/chat.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check-exports": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./chat.css"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=4",
    "@ai-sdk/deepseek": ">=3",
    "@ai-sdk/google": ">=3",
    "@ai-sdk/mistral": ">=3",
    "@ai-sdk/openai": ">=3",
    "@ai-sdk/xai": ">=3",
    "@openrouter/ai-sdk-provider": ">=3",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/deepseek": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@webmcp-agents/core": "workspace:^",
    "ai": "^7.0.163",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/deepseek": "^3.0.80",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/provider": "^4.0.36",
    "@ai-sdk/xai": "^5.0.39",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vite": "^8.3.6",
    "vitest-browser-react": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaskyer/web-agents.git",
    "directory": "packages/chat"
  },
  "publishConfig": {
    "access": "public"
  }
}
