{
  "name": "@webmcp-agents/tools",
  "version": "0.3.0",
  "type": "module",
  "description": "Common WebMCP tools, ready-made: get_time, get_location, get_page, go_to, go_back, scroll_to and set_theme. Framework-free, SSR-safe, one factory per tool.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@webmcp-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check-exports": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@webmcp-agents/core": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.23.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaskyer/web-agents.git",
    "directory": "packages/tools"
  },
  "publishConfig": {
    "access": "public"
  }
}
