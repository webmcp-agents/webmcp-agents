{
  "name": "@webmcp-agents/devtools",
  "version": "0.3.0",
  "type": "module",
  "description": "Devtools for WebMCP pages: see the tools on screen, run them from a generated form, watch every call.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "@webmcp-agents/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "@webmcp-agents/source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check-exports": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@tanstack/react-devtools": ">=0.10",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-devtools": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/devtools-event-client": "^0.5.1",
    "@webmcp-agents/core": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-devtools": "^0.10.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "vitest-browser-react": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafaskyer/web-agents.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public"
  }
}
